# Copy this file to .env and fill in real values before deploying.
# Never commit .env to version control.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_NAME=katibu
DB_USERNAME=katibu
DB_PASSWORD=change_me_strong_db_password

# ── JWT ─────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_64_char_random_string_with_openssl_rand_hex_32
JWT_EXPIRATION_MS=86400000

# ── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=change_me_access_key
MINIO_SECRET_KEY=change_me_strong_secret_key
MINIO_BUCKET=katibu-files

# ── Application ─────────────────────────────────────────────────────────────
# Frontend base URL embedded in generated public share links (must be the frontend domain)
FRONTEND_BASE_URL=https://katibu.my

# Comma-separated list of origins the gateway allows (no trailing slashes)
ALLOWED_ORIGINS=https://katibu.my,https://www.katibu.my

# ── Frontend ─────────────────────────────────────────────────────────────────
# Baked into the Vue.js bundle at build time — must match your production API domain
VUE_APP_API_URL=https://api.katibu.my
